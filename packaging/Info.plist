<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vorlage für das macOS-App-Bundle (PORT-6).

  Platzhalter, die `make-app.sh` beim Schreiben der echten Contents/Info.plist ersetzt:
    __VERSION__  -> CFBundleShortVersionString  (Standard: 0.1.2, env VERSION)
    __BUILD__    -> CFBundleVersion             (Standard: 2,     env BUILD)

  Dies ist eine Vorlage, kein fertiges Bundle-Info.plist. Sie wird von
  `make-app.sh` per sed in das Bundle kopiert und dort mit `plutil -lint` geprüft.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>de.reisinger.prime-photos</string>

	<key>CFBundleName</key>
	<string>Prime Photos</string>
	<key>CFBundleDisplayName</key>
	<string>Prime Photos</string>

	<key>CFBundleExecutable</key>
	<string>prime-photos</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- Agent-App: Das Dock-Icon wird bei geöffnetem Fenster über die
	     Laufzeit-Policy Regular/Accessory geschaltet (Original-Parität,
	     docs/original/SPEC_OS_INTEGRATION.md §3.4). -->
	<key>LSUIElement</key>
	<true/>

	<key>CFBundleIconFile</key>
	<string>AppIcon</string>

	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>

	<!-- Einzelinstanz-Schutz auf macOS-Seite (Original-Parität,
	     SPEC_OS_INTEGRATION.md §3.3: "single instance only"): Launch Services
	     lehnt einen zweiten Start ab und aktiviert stattdessen die laufende
	     Instanz. Startwege, die daran vorbeigehen (zweiter Aufruf aus der
	     Shell, Linux/Windows), deckt der Handshake in `src/single_instance.rs` ab. -->
	<key>LSMultipleInstancesProhibited</key>
	<true/>

	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
</dict>
</plist>
