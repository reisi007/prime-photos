<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vorlage für das macOS-App-Bundle (PORT-6).

  Platzhalter, die `make-app.sh` beim Schreiben der echten Contents/Info.plist ersetzt:
    __VERSION__  -> CFBundleShortVersionString  (Standard: 0.1.0, env VERSION)
    __BUILD__    -> CFBundleVersion             (Standard: 1,     env BUILD)

  Dies ist eine Vorlage, kein fertiges Bundle-Info.plist. Sie wird von
  `make-app.sh` per sed in das Bundle kopiert und dort mit `plutil -lint` geprüft.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>de.reisinger.prime-photos</string>

	<key>CFBundleName</key>
	<string>Prime Photos</string>
	<key>CFBundleDisplayName</key>
	<string>Prime Photos</string>

	<key>CFBundleExecutable</key>
	<string>prime-photos</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>

	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
</dict>
</plist>
